# Fider - Customer Feedback Board
# https://fider.io/

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=localhost

# App secret (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Admin email
APP_ADMIN_EMAIL=noreply@example.com

# Database credentials (PostgreSQL)
DB_CREATE_DATABASE_NAME=fider
DB_USER_NAME=fider
DB_USER_PASS=changeme_db_password

# Email / SMTP settings
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
